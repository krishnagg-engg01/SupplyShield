# Copy this file to ".env" (same folder) and fill in YOUR Exasol connection details (Exasol SaaS or Exasol Personal).
# ".env" is git-ignored. Never commit real credentials. Values below are placeholders only.

# Host and port of your Exasol database, as shown in its connection details, written as host:port
# (Exasol SaaS: use the connection string from the web console and port 8563; the password is your personal access token)
EXASOL_DSN=<host-or-ip>:<port>
EXASOL_USER=<your-exasol-user>
EXASOL_PASSWORD=<your-exasol-password>

# Optional
EXASOL_SCHEMA=SUPPLYSHIELD
# Set to false ONLY for a self-signed certificate on a development instance
EXASOL_VALIDATE_CERT=true
